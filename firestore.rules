rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 人數少、非公開的私人小遊戲，故意完全開放讀寫，不做 Firebase Auth。
    match /students/{studentId} {
      allow read, write: if true;

      match /questionProgress/{questionId} {
        allow read, write: if true;
      }
    }

    // 高分榜是累加紀錄，只允許新增，不允許事後竄改/刪除既有分數。
    match /highScores/{scoreId} {
      allow read, create: if true;
      allow update, delete: if false;
    }

    // 拔河問答小遊戲（tug-of-war/）專用的 collection，跟上面 Snake Game 的
    // students/highScores 完全分開存放，兩個遊戲互不影響。
    match /tugofwar_matches/{matchId} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /tugofwar_students/{studentId} {
      allow read, write: if true;

      match /questions/{questionId} {
        allow read, write: if true;
      }
    }
  }
}
